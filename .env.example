# Copy to .env to override defaults. NOTHING secret lives here — signing keys and the
# admin token are generated at bootstrap and printed/persisted, never committed.

# --- Issuer / hosts ---
FABRIC_IDP_HOST=127.0.0.1
FABRIC_IDP_PORT=9400
# Internal-only IdP surface (/token, /admin/*) — keep this off any publicly published
# port in a real deployment; see compose.yaml's `idp-internal` service.
FABRIC_IDP_INTERNAL_HOST=127.0.0.1
FABRIC_IDP_INTERNAL_PORT=9410
FABRIC_SP_A_PORT=9401
FABRIC_SP_B_PORT=9402

# --- Cookies (turn ON in production) ---
FABRIC_COOKIE_SECURE=false

# --- Audit log source IP ---
# Comma-separated IPs allowed to set X-Forwarded-For for the audit trail's `source_ip`.
# Leave empty unless there is a trusted reverse proxy in front of these services —
# otherwise any client could forge its own logged source IP.
FABRIC_TRUSTED_PROXY_IPS=

# --- Session lifetimes (seconds) ---
FABRIC_IDP_SESSION_IDLE_SECONDS=900
FABRIC_IDP_SESSION_ABSOLUTE_SECONDS=28800
FABRIC_SP_SESSION_IDLE_SECONDS=900
FABRIC_SP_SESSION_ABSOLUTE_SECONDS=28800

# --- Token lifetimes (seconds) ---
FABRIC_ACCESS_TOKEN_TTL_SECONDS=300
FABRIC_ID_TOKEN_TTL_SECONDS=300
FABRIC_AUTH_CODE_TTL_SECONDS=60
FABRIC_CLIENT_ASSERTION_MAX_TTL_SECONDS=120

# --- Data directory (SQLite files land here) ---
FABRIC_DATA_DIR=./data
